APP_NAME="VARBAF"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Douala

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=varbaf
DB_USERNAME=postgres
DB_PASSWORD=
DB_CHARSET=utf8
DB_SCHEMA=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@varbaf.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Assistant d'interrogation — recherche et rédaction
# ---------------------------------------------------------------------
# Tout ce bloc est FACULTATIF. Sans une seule de ces variables, le
# système fonctionne : l'assistant retrouve les extraits par similarité
# lexicale et les présente en liste. C'est le comportement livré, celui
# que la suite de tests éprouve, et celui qui ne dépend de rien.

# Embeddings de la branche dense (Ollama, en local).
# La branche dense a été mesurée le 27/08 puis retirée de l'ordre de
# résolution : elle annulait le refus sans gagner en rappel. Ces réglages
# ne servent donc plus qu'à « varbaf:indexer-vecteurs » et à la mesure
# comparative de « varbaf:evaluer-assistant ». Voir le motif chiffré dans
# Modules/Pilotage/config/config.php.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODELE_EMBEDDINGS=nomic-embed-text

# Rédaction générative : met les extraits retrouvés en français suivi.
# Le modèle ne cherche rien et ne calcule rien — il ne voit que les
# extraits déjà trouvés, et sa sortie est relue par GardeDesChiffres,
# qui bascule en refus si un chiffre n'apparaît dans aucun extrait.
# Mettre à false coupe la rédaction sans retirer les clés : de quoi
# démontrer le repli en changeant un caractère.
# PILOTAGE_REDACTION=true

# Profil local — un modèle sur la machine, via Ollama.
# Gratuit, sans clé, et surtout sans connexion : c'est le seul profil qui
# fonctionne dans une salle de soutenance sans réseau. Il passe devant le
# distant dès qu'un modèle est tiré (« ollama pull qwen2.5:3b »).
# REDACTION_LOCALE_URL=http://127.0.0.1:11434
# REDACTION_LOCALE_MODELE=qwen2.5:3b

# Profil distant — n'importe quel service parlant le dialecte OpenAI
# « POST {url}/v1/chat/completions ». Bases connues :
#   Groq        https://api.groq.com/openai   (palier gratuit, sans carte)
#   Cerebras    https://api.cerebras.ai
#   Mistral     https://api.mistral.ai
#   OpenRouter  https://openrouter.ai/api
#   xAI         https://api.x.ai              (payant)
#
# ATTENTION : un identifiant de modèle est une valeur périssable.
# « llama-3.3-70b-versatile » a été retiré du palier gratuit de Groq le
# 16/08/2026. Un modèle déprécié ne dégrade pas la réponse, il la refuse,
# et le repli le fait en silence. Vérifier avant une démonstration :
#   curl -s -H "Authorization: Bearer <cle>" https://api.groq.com/openai/v1/models
# REDACTION_DISTANTE_URL=https://api.groq.com/openai
# REDACTION_DISTANTE_MODELE=openai/gpt-oss-120b
# REDACTION_DISTANTE_CLE=
